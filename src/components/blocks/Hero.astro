---
import { urlForImage } from "../../sanity/lib/url-for-image";
import { Image } from "astro:assets";
import PortableText from "../PortableText.astro";

interface Props {
  title?: string;
  text?: any;
  image?: any;
}
const { title, text, image } = Astro.props;
console.log("================================================");
console.log(text);
---

<section
  class="bg-black/60 relative overflow-hidden px-4 py-8 md:p-12 h-[60vh]"
>
  {
    image && (
      <Image
        class="absolute left-0 top-0 -z-50 h-full w-full object-cover max-md:scale-x-[-1]"
        src={urlForImage(image).width(1600).height(800).url()}
        width="1600"
        height="800"
        alt=""
      />
    )
  }
  <div class="mx-auto max-w-5xl md:h-screen md:pt-24">
    {title && <h1 class="font-bold text-6xl text-white pb-8">{title}</h1>}
    <div
      class="text-white mb-3 max-w-[30ch] font-lora text-base font-light text-secondary-100 md:text-2xl"
    >
      {text && <PortableText value={text} />}
    </div>
  </div>
</section>
